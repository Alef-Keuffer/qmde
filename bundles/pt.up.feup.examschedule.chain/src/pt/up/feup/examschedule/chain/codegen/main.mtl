[module main('https://pt/up/feup/examschedule/conflictgraph')/]

[comment @main/]
[template public generate(g : conflictgraph::ConflictGraph)]
  [file ('qaoa_' + g.name + '.py', overwrite, 'UTF-8')]
    # Generated by Acceleo from the Conflict Graph of '[g.name/]'. Do not edit.

    N_BATCHES = [g.nBatches/]
    EXAMS = ([for (e | g.exams)]'[e.name/]', [/for])
    CONFLICTS = ([for (c | g.conflicts)]('[c.first.name/]', '[c.second.name/]'), [/for])

    if __name__ == '__main__':
        print(f"{len(EXAMS)} exams, {len(CONFLICTS)} conflicts, {N_BATCHES} batches")
        for a, b in CONFLICTS:
            print(f"  conflict: {a} -- {b}")
  [/file]
[/template]
