[module main('https://pt/up/feup/examschedule/ising', 'https://pt/up/feup/examschedule/solverconfig', 'https://pt/up/feup/examschedule/conflictgraph')/]

[import pt::up::feup::examschedule::chain::codegen::ModelServices/]

[comment @main/]
[template public generate(m : ising::IsingModel)]
  [let cfg = m.solverConfig()]
    [let g = m.conflictGraph()]
      [file ('qaoa_' + m.name + '.py', overwrite, 'UTF-8')]
        # Generated by Acceleo (codegen/main.mtl) from the models of '[m.name/]'. Do not edit: change the
        # models or the transformations instead (ADR-0004).
        """QAOA for the exam-slot assignment instance '[m.name/]'."""
        from examqaoa import Instance, solve

        # Solver Configuration (solverconfig.xmi)
        DEPTH = [cfg.depth/]
        OPTIMIZER = '[cfg.optimizer/]'
        MAX_ITERATIONS = [cfg.maxIterations/]
        SHOTS = [cfg.shots/]
        SEED = [cfg.seed/]

        # Ising model (ising.xmi): E(z) = OFFSET + sum_i h_i z_i + sum_ij J_ij z_i z_j, z_i = 1 - 2 x_i
        OFFSET = [m.offset/]
        FIELDS = {[for (f | m.fields) separator(', ')][f.spin.index/]: [f.h/][/for]}
        COUPLINGS = {[for (c | m.couplings) separator(', ')]([c.first.index/], [c.second.index/]): [c.j/][/for]}
        # Decoding table: qubit i is the assignment variable (exam, batch)
        QUBITS = ([for (s | m.spins)]('[s.exam/]', [s.batch/]), [/for])

        # Problem data (conflictgraph.xmi), for checking schedules and the classical baseline
        N_BATCHES = [g.batches->size()/]
        WEIGHTS = {[for (e | g.exams) separator(', ')]'[e.name/]': [e.weight/][/for]}
        CONFLICTS = ([for (c | g.conflicts)]('[c.first.name/]', '[c.second.name/]'), [/for])

        # Normalise the cost Hamiltonian for the QAOA angles; the minimiser is unchanged.
        SCALE = max(abs(v) for v in (*FIELDS.values(), *COUPLINGS.values()))


        def qaoa_layer(qc, gamma, beta):
            """One QAOA layer, gate by gate from the Ising model (Farhi, Goldstone, Gutmann 2014, §2)."""
            # Cost unitary exp(-i gamma H_C): RZ(2 gamma h_i) per local field ...
            [for (f | m.fields)]
              qc.rz(2 * gamma * [f.h/] / SCALE, [f.spin.index/])  # [f.spin.label/]
            [/for]
            # ... and RZZ(2 gamma J_ij) per coupling.
            [for (c | m.couplings)]
              qc.rzz(2 * gamma * [c.j/] / SCALE, [c.first.index/], [c.second.index/])  # [c.first.label/] [c.second.label/]
            [/for]
            # Mixer unitary exp(-i beta B), B = sum_i X_i: RX(2 beta) per qubit.
            [for (s | m.spins)]
              qc.rx(2 * beta, [s.index/])
            [/for]


        if __name__ == '__main__':
            solve(Instance('[m.name/]', DEPTH, OPTIMIZER, MAX_ITERATIONS, SHOTS, SEED, OFFSET, FIELDS, COUPLINGS,
                           QUBITS, N_BATCHES, WEIGHTS, CONFLICTS), qaoa_layer)
      [/file]
    [/let]
  [/let]
[/template]
