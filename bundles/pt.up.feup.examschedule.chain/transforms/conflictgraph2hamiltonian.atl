-- @atlcompiler emftvm
-- @nsURI ConflictGraph=https://pt/up/feup/examschedule/conflictgraph
-- @nsURI SolverConfig=https://pt/up/feup/examschedule/solverconfig
-- @nsURI Hamiltonian=https://pt/up/feup/examschedule/hamiltonian
-- Conflict Graph (+ Solver Configuration) -> Hamiltonian.
-- [Paper] = "Hybrid quantum annealing for large-scale exam scheduling", Applied Soft Computing 184.
-- [Lucas] = A. Lucas, "Ising formulations of many NP problems", Frontiers in Physics, 2014.
module conflictgraph2hamiltonian;

create OUT : Hamiltonian from IN : ConflictGraph, CFG : SolverConfig;

helper def : config : SolverConfig!SolverConfig =
	SolverConfig!SolverConfig.allInstancesFrom('CFG')->first();

-- ADR-0001: automatic penalty coefficient A = max_i w_i + 1, so dropping an exam (cost w_i)
-- is always cheaper than breaking a hard constraint (cost >= A). A manual value overrides it.
helper context ConflictGraph!ConflictGraph def : penaltyCoefficient : Real =
	if thisModule.config.penaltyCoefficient.oclIsUndefined() then
		self.exams->iterate(e; m : Real = 0.0 | m.max(e.weight)) + 1.0
	else
		thisModule.config.penaltyCoefficient
	endif;

rule ConflictGraph2Hamiltonian {
	from
		g : ConflictGraph!ConflictGraph
	to
		h : Hamiltonian!Hamiltonian (
			name <- g.name,
			penaltyCoefficient <- g.penaltyCoefficient,
			exams <- g.exams,
			batches <- g.batches,
			variables <- g.exams->collect(e | g.batches->collect(b | thisModule.Variable(e, b)))->flatten(),
			components <- Sequence{reward, atMostOneBatch, noSharedBatch}
		),
		-- ADR-0001: reward each scheduled exam by its weight, -sum_i w_i sum_k x_ik.
		reward : Hamiltonian!Component (
			kind <- #REWARD,
			reference <- 'ADR-0001: -sum_i w_i sum_k x[i,k]',
			penalized <- false,
			terms <- g.exams->collect(e |
					g.batches->collect(k | thisModule.Term(0.0 - e.weight, Sequence{thisModule.Variable(e, k)})))->flatten()
		),
		-- [Paper §3.2, Eq. (5)-(7)] H_const1 = sum_i (tau_i - 1)^2 forces exactly one batch; ADR-0001
		-- relaxes it to at most one batch, the pairwise penalty sum_i sum_{k<l} x[i,k] x[i,l] [Lucas §2.3].
		atMostOneBatch : Hamiltonian!Component (
			kind <- #AT_MOST_ONE_BATCH,
			reference <- 'Paper Eq. (7) relaxed by ADR-0001: sum_i sum_{k<l} x[i,k] x[i,l]',
			penalized <- true,
			terms <- g.exams->collect(e |
					g.batches->collect(k |
						g.batches->select(l | k.index < l.index)->collect(l |
							thisModule.Term(1.0, Sequence{thisModule.Variable(e, k), thisModule.Variable(e, l)}))))->flatten()
		),
		-- [Paper §3.2, Eq. (8)-(9)] H_const2 = sum_{i,j} sum_k C[i,j] x[i,k] x[j,k]; each conflict is
		-- one unordered pair here, so the penalty is counted once (Eq. (9) counts both (i,j) and (j,i)).
		noSharedBatch : Hamiltonian!Component (
			kind <- #NO_SHARED_BATCH,
			reference <- 'Paper Eq. (9): sum_{(i,j) in C} sum_k x[i,k] x[j,k]',
			penalized <- true,
			terms <- g.conflicts->collect(c |
					g.batches->collect(k |
						thisModule.Term(1.0, Sequence{thisModule.Variable(c.first, k), thisModule.Variable(c.second, k)})))->flatten()
		)
}

rule Exam2Exam {
	from
		e : ConflictGraph!Exam
	to
		x : Hamiltonian!Exam (
			name <- e.name,
			weight <- e.weight
		)
}

rule Batch2Batch {
	from
		b : ConflictGraph!Batch
	to
		x : Hamiltonian!Batch (
			index <- b.index
		)
}

-- [Paper §3.2, Eq. (4)]: X[i,k] = 1 iff exam i is examined in batch k.
unique lazy rule Variable {
	from
		e : ConflictGraph!Exam,
		b : ConflictGraph!Batch
	to
		v : Hamiltonian!AssignmentVariable (
			name <- 'x[' + e.name + ',' + b.index.toString() + ']',
			exam <- e,
			batch <- b
		)
}

rule Term(coefficient : Real, variables : Sequence(Hamiltonian!AssignmentVariable)) {
	to
		t : Hamiltonian!Term (
			coefficient <- coefficient,
			variables <- variables
		)
	do {
		t;
	}
}
