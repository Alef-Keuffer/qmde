-- @atlcompiler emftvm
-- @nsURI QUBO=https://pt/up/feup/examschedule/qubo
-- @nsURI Ising=https://pt/up/feup/examschedule/ising
-- QUBO -> Ising model by substituting x_i = (1 - z_i)/2 [Lucas §2.1; Glover et al. 2019, §6]:
--   a x_i       = a/2 - (a/2) z_i
--   b x_i x_j   = b/4 (1 - z_i - z_j + z_i z_j)
-- so h_i = -a_i/2 - sum_j b_ij/4, J_ij = b_ij/4, offset = c + sum_i a_i/2 + sum_ij b_ij/4.
module qubo2ising;

create OUT : Ising from IN : QUBO;

helper context QUBO!Variable def : qubo : QUBO!QUBO =
	self.refImmediateComposite();

helper context QUBO!Variable def : h : Real =
	0.0 - self.qubo.linearTerms->select(t | t.variable = self)->iterate(t; s : Real = 0.0 | s + t.coefficient) / 2.0
		- self.qubo.quadraticTerms->select(t | t.first = self or t.second = self)->iterate(t; s : Real = 0.0 | s + t.coefficient) / 4.0;

rule QUBO2Ising {
	from
		q : QUBO!QUBO
	to
		m : Ising!IsingModel (
			name <- q.name,
			offset <- q.offset
				+ q.linearTerms->iterate(t; s : Real = 0.0 | s + t.coefficient / 2.0)
				+ q.quadraticTerms->iterate(t; s : Real = 0.0 | s + t.coefficient / 4.0),
			spins <- q.variables,
			fields <- q.variables->collect(v | thisModule.Field(v)),
			couplings <- q.quadraticTerms
		)
}

rule Variable2Spin {
	from
		v : QUBO!Variable
	to
		s : Ising!Spin (
			index <- v.index,
			label <- v.label,
			exam <- v.exam,
			batch <- v.batch
		)
}

lazy rule Field {
	from
		v : QUBO!Variable
	to
		f : Ising!Field (
			spin <- v,
			h <- v.h
		)
}

rule QuadraticTerm2Coupling {
	from
		t : QUBO!QuadraticTerm
	to
		c : Ising!Coupling (
			first <- t.first,
			second <- t.second,
			j <- t.coefficient / 4.0
		)
}
