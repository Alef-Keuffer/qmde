// Textual syntax for Problem models (imports problem.ecore; it does not generate its own metamodel).
// Stub for the walking skeleton: the Solver Configuration section and wrapper root come later.
grammar pt.up.feup.examschedule.dsl.Exam with org.eclipse.xtext.common.Terminals

import "https://pt/up/feup/examschedule/problem"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

Problem returns Problem:
	'problem' name=ID 'batches' nBatches=INT
	'students' students+=Student+
	exams+=Exam*;

Student returns Student:
	name=ID;

Exam returns Exam:
	'exam' name=ID 'weight' weight=Weight '{' students+=[Student|ID]+ '}';

Weight returns ecore::EDouble:
	INT ('.' INT)?;
