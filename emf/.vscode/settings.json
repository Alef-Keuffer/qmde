{
  // The Java language server would import emf/'s bundles as Maven projects and rewrite their .project files (#7);
  // the first four patterns are its defaults.
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/emf/**"
  ]
}
