[module main('https://pt/up/feup/examschedule/conflictgraph', 'https://pt/up/feup/examschedule/solverconfig')/]

[import pt::up::feup::examschedule::chain::codegen::ModelServices/]

[comment Acceleo reads every opening bracket as its own syntax, so each literal one in the Python is an escape expression. /]

[comment @main/]
[template public generate(g : conflictgraph::ConflictGraph)]
  [let cfg = g.solverConfig()]
    [file ('solve_' + g.name + '.py', overwrite, 'UTF-8')]
      # Generated by Acceleo (codegen/main.mtl) from the models of '[g.name/]'. Do not edit: change the
      # models or the transformations instead (ADR-0007).
      """Exam-slot assignment for '[g.name/]': the weighted QUBO (ADR-0009), built with pyqubo as in the paper's notebook."""
      # Paper: Zhou et al., Applied Soft Computing 184 (2025); Notebook: emf/QuantumExamScheduling.ipynb;
      # Lucas: arXiv:1302.5843; Glover: arXiv:1811.11538.
      from pyqubo import Array, Constraint, Placeholder

      from examschedule import Problem, SolverConfig, solve

      # Solver Configuration (solverconfig.xmi); penalty None means automatic, the largest weight plus one
      CONFIG = SolverConfig(method='[cfg.method/]', penalty=[if (cfg.penaltyCoefficient = null)]None[else][cfg.penaltyCoefficient/][/if], seed=[cfg.seed/],
                            reads=[cfg.reads/], sweeps=[cfg.sweeps/],
                            depth=[cfg.depth/], optimizer='[cfg.optimizer/]', max_iterations=[cfg.maxIterations/], shots=[cfg.shots/])

      # Conflict Graph (conflictgraph.xmi)
      EXAMS = ([for (e | g.exams)]'[e.name/]', [/for])
      WEIGHTS = ([for (e | g.exams)][e.weight/], [/for])
      N_BATCHES = [g.nBatches/]
      # ['['/]Paper §5.2, Algorithm 1, Eq. (3)] ['['/]Notebook cell 7]: C, the contradiction matrix, as pairs (i, j), i < j.
      CONFLICTS = ([for (c | g.conflicts)]([g.exams->indexOf(c.first) - 1/], [g.exams->indexOf(c.second) - 1/]), [/for])

      # From here on, the notebook's formulation, made a weighted set packing (ADR-0009): each exam in at
      # most one batch instead of exactly one, the weights as priorities.
      n_lesson = len(EXAMS)
      n_batch = N_BATCHES

      # ['['/]Paper §5.3, Eq. (4)] ['['/]Notebook cell 11]: x['['/]i, k] = 1 iff exam i is in batch k + 1
      x = Array.create('c', (n_lesson, n_batch), 'BINARY')

      # ['['/]Glover §4, known penalties, row 5] ['['/]Lucas §4.2, Eq. (30)]: each exam in at most one batch, the paper's
      # exactly-one ['['/]Paper §5.3, Eqs. (5)-(7)] relaxed (ADR-0009). With one batch there is no pair to forbid.
      constraint1 = 0.0
      for i in range(n_lesson):
          if n_batch > 1:
              constraint1 += Constraint(sum(x['['/]i, k] * x['['/]i, l] for k in range(n_batch) for l in range(k + 1, n_batch)),
                                        label="at-most-one-batch-{}".format(EXAMS['['/]i]))

      # ['['/]Paper §5.3, Eqs. (8)-(9)] ['['/]Notebook cell 12]: conflicting exams never share a batch, the penalty
      # x['['/]i, k] x['['/]j, k] of ['['/]Glover §4, known penalties, row 1].
      constraint2 = 0.0
      for i in range(n_lesson):
          for j in range(i + 1, n_lesson):
              for k in range(n_batch):
                  if (i, j) in CONFLICTS:
                      constraint2 += Constraint(x['['/]i, k] * x['['/]j, k],
                                                label="conflict-{}-{}-batch-{}".format(EXAMS['['/]i], EXAMS['['/]j], k + 1))

      # ['['/]Glover §4.2] ['['/]Lucas §4.2, Eq. (31)]: scheduling exam i earns its weight; an unscheduled exam costs it
      profit = -sum(WEIGHTS['['/]i] * x['['/]i, k] for i in range(n_lesson) for k in range(n_batch))

      # ['['/]Paper §5.3, Eq. (10)] ['['/]Notebook cell 13]: H, with lambda = gamma = A and the profit added; A is fed
      # from the Solver Configuration
      A = Placeholder("A")
      H = profit + A * (constraint1 + constraint2)
      model = H.compile()


      if __name__ == '__main__':
          solve(Problem('[g.name/]', EXAMS, WEIGHTS, N_BATCHES, CONFLICTS), CONFIG, model)
    [/file]
  [/let]
[/template]
