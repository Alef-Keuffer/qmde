-- @atlcompiler emftvm
-- @nsURI Problem=https://pt/up/feup/examschedule/problem
-- @nsURI ConflictGraph=https://pt/up/feup/examschedule/conflictgraph
-- Problem -> Conflict Graph.
-- Paper: Z. Zhou et al., "Hybrid quantum annealing for large-scale exam scheduling", Applied Soft
-- Computing 184 (2025); Glover: arXiv:1811.11538.
module problem2conflictgraph;

create OUT : ConflictGraph from IN : Problem;

rule Problem2ConflictGraph {
	from
		p : Problem!Problem
	to
		-- [Paper §5.2, Fig. 3]: the conflict graph G, exams as nodes and conflicts as edges.
		g : ConflictGraph!ConflictGraph (
			name <- p.name,
			exams <- p.exams,
			-- [Paper §5.3, Eq. (4)]: X has only M columns, so the M batches bound the schedule.
			nBatches <- p.nBatches,
			conflicts <- p.exams->collect(a |
					p.exams->select(b | p.exams->indexOf(a) < p.exams->indexOf(b) and a.sharesStudentWith(b))
						->collect(b | thisModule.Conflict(a, b)))->flatten()
		)
}

rule Exam2Exam {
	from
		e : Problem!Exam
	to
		-- [Paper §5.2, Fig. 3]: each exam is a node of G.
		x : ConflictGraph!Exam (
			name <- e.name,
			-- [Glover §4.2]: the weight w_j of the set packing objective, the exam's priority (ADR-0009).
			weight <- e.weight
		)
}

-- [Paper §5.2, Algorithm 1, Eq. (3)]: C[i,j] = 1 iff some student sits both exam i and exam j.
helper context Problem!Exam def : sharesStudentWith(other : Problem!Exam) : Boolean =
	self.students->exists(s | other.students->includes(s));

-- [Paper §5.2, Fig. 3]: one edge of G per pair with C[i,j] = 1, emitted once, in problem order.
lazy rule Conflict {
	from
		a : Problem!Exam,
		b : Problem!Exam
	to
		c : ConflictGraph!Conflict (
			first <- a,
			second <- b
		)
}
