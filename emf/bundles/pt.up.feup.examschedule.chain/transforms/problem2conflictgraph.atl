-- @atlcompiler emftvm
-- @nsURI Problem=https://pt/up/feup/examschedule/problem
-- @nsURI ConflictGraph=https://pt/up/feup/examschedule/conflictgraph
-- Problem -> Conflict Graph.
-- [Paper] = "Hybrid quantum annealing for large-scale exam scheduling", Applied Soft Computing 184.
module problem2conflictgraph;

create OUT : ConflictGraph from IN : Problem;

rule Problem2ConflictGraph {
	from
		p : Problem!Problem
	to
		g : ConflictGraph!ConflictGraph (
			name <- p.name,
			exams <- p.exams,
			-- [Paper §3.2, Eq. (4)]: batches k = 1..M bound the schedule.
			batches <- thisModule.range(p.nBatches)->collect(k | thisModule.NewBatch(k)),
			conflicts <- p.exams->collect(a |
					p.exams->select(b | p.exams->indexOf(a) < p.exams->indexOf(b) and a.sharesStudentWith(b))
						->collect(b | thisModule.Conflict(a, b)))->flatten()
		)
}

rule Exam2Exam {
	from
		e : Problem!Exam
	to
		x : ConflictGraph!Exam (
			name <- e.name,
			-- ADR-0009: the weight is the exam's priority, the cost of leaving it unscheduled.
			weight <- e.weight
		)
}

-- Sequence{1, ..., n}.
helper def : range(n : Integer) : Sequence(Integer) =
	if n < 1 then Sequence{} else thisModule.range(n - 1)->append(n) endif;

rule NewBatch(k : Integer) {
	to
		b : ConflictGraph!Batch (
			index <- k
		)
	do {
		b;
	}
}

-- [Paper §3.2, Algorithm 1]: course conflict matrix C, C[i,j] = 1 iff some student
-- sits both exam i and exam j. Each unordered pair is emitted once, in problem order.
helper context Problem!Exam def : sharesStudentWith(other : Problem!Exam) : Boolean =
	self.students->exists(s | other.students->includes(s));

lazy rule Conflict {
	from
		a : Problem!Exam,
		b : Problem!Exam
	to
		c : ConflictGraph!Conflict (
			first <- a,
			second <- b
		)
}
