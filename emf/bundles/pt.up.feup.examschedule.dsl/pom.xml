<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>pt.up.feup.examschedule</groupId>
    <artifactId>parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>pt.up.feup.examschedule.dsl</artifactId>
  <packaging>eclipse-plugin</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- m2e must not run this inside Eclipse: Mwe2Launcher calls System.exit on failure, killing the IDE. -->
            <?m2e ignore?>
            <id>mwe2</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>${project.basedir}/src/pt/up/feup/examschedule/dsl/GenerateExam.mwe2</argument>
                <argument>-p</argument>
                <!-- Relative to the repository root (where mvnw is run): ANTLR 3 cannot read grammar
                     paths containing non-ASCII characters, which an absolute path may have. -->
                <argument>rootPath=bundles</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
