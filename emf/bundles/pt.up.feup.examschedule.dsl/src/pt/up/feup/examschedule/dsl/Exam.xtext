// Textual syntax for a Problem and its Solver Configuration (CONTEXT.md, Q19). It imports the
// hand-written metamodels; only the ExamFile wrapper root is generated by Xtext.
grammar pt.up.feup.examschedule.dsl.Exam with org.eclipse.xtext.common.Terminals

import "platform:/resource/pt.up.feup.examschedule.model/model/problem.ecore" as problem
import "platform:/resource/pt.up.feup.examschedule.model/model/solverconfig.ecore" as solver
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
generate exam "https://pt/up/feup/examschedule/dsl/exam"

ExamFile:
	problem=Problem
	solver=SolverConfig?;

Problem returns problem::Problem:
	'problem' name=ID 'batches' nBatches=INT
	'students' students+=Student+
	exams+=Exam+;

Student returns problem::Student:
	name=ID;

Exam returns problem::Exam:
	'exam' name=ID '{' students+=[problem::Student|ID]+ '}';

// Settings in any order; omitted ones keep the metamodel defaults. depth, optimizer, iterations and
// shots apply to QAOA; reads and sweeps to simulated annealing.
SolverConfig returns solver::SolverConfig:
	{solver::SolverConfig} 'solver' '{' (
		('method' method=Method)? &
		('penalty' penaltyCoefficient=Number)? &
		('seed' seed=INT)? &
		('reads' reads=INT)? &
		('sweeps' sweeps=INT)? &
		('depth' depth=INT)? &
		('optimizer' optimizer=Optimizer)? &
		('iterations' maxIterations=INT)? &
		('shots' shots=INT)?
	) '}';

enum Method returns solver::Method:
	QAOA='QAOA' | ANNEALING='annealing';

enum Optimizer returns solver::Optimizer:
	COBYLA='COBYLA' | NELDER_MEAD='Nelder-Mead' | POWELL='Powell';

Number returns ecore::EDouble:
	INT ('.' INT)?;
