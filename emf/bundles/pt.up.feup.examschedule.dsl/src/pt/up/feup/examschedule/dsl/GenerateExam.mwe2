module pt.up.feup.examschedule.dsl.GenerateExam

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."

Workflow {
	// Makes platform:/resource/pt.up.feup.examschedule.model/... resolvable for the imported genmodel.
	bean = org.eclipse.emf.mwe.utils.StandaloneSetup {
		platformUri = rootPath
		scanClassPath = true
	}
	component = XtextGenerator {
		configuration = {
			project = StandardProjectConfig {
				baseName = "pt.up.feup.examschedule.dsl"
				rootPath = rootPath
				eclipsePlugin = {
					enabled = true
				}
				createEclipseMetaData = true
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				fileHeader = "/*\n * generated by Xtext \${version}\n */"
				preferXtendStubs = false
			}
		}
		language = StandardLanguage {
			name = "pt.up.feup.examschedule.dsl.Exam"
			grammarUri = "platform:/resource/pt.up.feup.examschedule.dsl/src/pt/up/feup/examschedule/dsl/Exam.xtext"
			fileExtensions = "exam"
			referencedResource = "platform:/resource/pt.up.feup.examschedule.model/model/problem.genmodel"
			referencedResource = "platform:/resource/pt.up.feup.examschedule.model/model/solverconfig.genmodel"
			serializer = {
				generateStub = false
			}
			validator = {
			}
		}
	}
}
