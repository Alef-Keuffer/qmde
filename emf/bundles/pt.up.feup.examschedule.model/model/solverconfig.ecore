<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="solverconfig" nsURI="https://pt/up/feup/examschedule/solverconfig"
    nsPrefix="solverconfig">
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="invocationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"/>
    <details key="settingDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"/>
    <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="How a problem is solved, as opposed to what the problem is (solving method, its settings and the penalty coefficient)."/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EEnum" name="Method">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="How the compiled pyqubo model is sampled: QAOA on the Qiskit Aer simulator, or simulated annealing (neal) as in the reference notebook (ADR-0007)."/>
    </eAnnotations>
    <eLiterals name="QAOA"/>
    <eLiterals name="ANNEALING" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Optimizer">
    <eLiterals name="COBYLA"/>
    <eLiterals name="NELDER_MEAD" value="1"/>
    <eLiterals name="POWELL" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SolverConfig">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Solver Configuration. depth, optimizer, maxIterations and shots apply to QAOA; reads and sweeps to simulated annealing; seed and penaltyCoefficient to both."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="positiveDepth positiveIterations positiveShots positiveReads positiveSweeps positivePenalty"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="positiveDepth" value="depth >= 1"/>
      <details key="positiveIterations" value="maxIterations >= 1"/>
      <details key="positiveShots" value="shots >= 1"/>
      <details key="positiveReads" value="reads >= 1"/>
      <details key="positiveSweeps" value="sweeps >= 1"/>
      <details key="positivePenalty" value="penaltyCoefficient > 0"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="method" eType="#//Method"
        defaultValueLiteral="QAOA"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="penaltyCoefficient" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        defaultValueLiteral="1000.0">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value fed to the pyqubo Placeholder A; the notebook uses 1e3."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="seed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="7"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reads" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="50"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sweeps" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="10000"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="depth" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="optimizer" eType="#//Optimizer"
        defaultValueLiteral="COBYLA"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxIterations" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="100"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="shots" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="1024"/>
  </eClassifiers>
</ecore:EPackage>
