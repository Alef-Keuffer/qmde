<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>pt.up.feup.examschedule</groupId>
    <artifactId>parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>run</artifactId>
  <packaging>pom</packaging>

  <!-- Runs the model chain headlessly as an Eclipse application (ADR-0003) on every .exam file in
       instances/, then runs the generated QAOA scripts in a Python virtual environment.
       Override with -Dproblem=<file or folder> -Dout=<folder>. -->
  <properties>
    <problem>${maven.multiModuleProjectDirectory}/instances</problem>
    <out>${maven.multiModuleProjectDirectory}/out</out>
    <python>python3.12</python>
    <venv>${maven.multiModuleProjectDirectory}/.venv</venv>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-eclipse-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <repositories>
            <repository>
              <id>simrel</id>
              <layout>p2</layout>
              <url>https://download.eclipse.org/releases/2026-09</url>
            </repository>
            <repository>
              <id>chain</id>
              <layout>p2</layout>
              <url>${project.baseUri}../pt.up.feup.examschedule.repository/target/repository</url>
            </repository>
          </repositories>
          <dependencies>
            <dependency>
              <artifactId>pt.up.feup.examschedule.chain</artifactId>
              <type>eclipse-plugin</type>
            </dependency>
            <dependency>
              <artifactId>org.apache.felix.scr</artifactId>
              <type>eclipse-plugin</type>
            </dependency>
          </dependencies>
          <applicationArgs>
            <args>-application</args>
            <args>pt.up.feup.examschedule.chain.run</args>
            <args>-consoleLog</args>
            <args>${problem}</args>
            <args>${out}</args>
          </applicationArgs>
        </configuration>
        <executions>
          <execution>
            <id>run-chain</id>
            <phase>verify</phase>
            <goals>
              <goal>eclipse-run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>create-venv</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${python}</executable>
              <arguments>
                <argument>-m</argument>
                <argument>venv</argument>
                <argument>${venv}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>install-requirements</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${venv}/bin/python</executable>
              <arguments>
                <argument>-m</argument>
                <argument>pip</argument>
                <argument>install</argument>
                <argument>--quiet</argument>
                <argument>--disable-pip-version-check</argument>
                <argument>-r</argument>
                <argument>${maven.multiModuleProjectDirectory}/requirements.txt</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>run-generated-code</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${venv}/bin/python</executable>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/python/run_generated.py</argument>
                <argument>${out}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
